# Public base URL of the Django REST API.
# Only NEXT_PUBLIC_* vars are exposed to the browser bundle.
# NEVER put secrets, API keys, or credentials here (CLAUDE.md §3/§5).
#
# Must be reachable FROM THE BROWSER. When you open the app from another device
# via a LAN IP, point this at the backend's LAN address, not localhost, e.g.
# NEXT_PUBLIC_API_BASE_URL=http://192.168.1.24:8000/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Extra dev-server origins for Next's HMR/asset checks (comma-separated host
# names or IPs, no scheme/port). Needed when reaching `next dev` from a non-
# localhost host (e.g. binding 0.0.0.0 and opening http://192.168.1.24:3000).
# NEXT_DEV_ORIGINS=192.168.1.24
